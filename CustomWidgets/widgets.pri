# Sources of the custom widgets of the GUI, built as a static library by
# CustomWidgets.pro

INCLUDEPATH += $$PWD

HEADERS += \
    $$PWD/wClockFace.h \
    $$PWD/wDial.h \
    $$PWD/wPowerBars.h \
    $$PWD/wToggle.h

SOURCES += \
    $$PWD/wClockFace.cpp \
    $$PWD/wDial.cpp \
    $$PWD/wPowerBars.cpp \
    $$PWD/wToggle.cpp
