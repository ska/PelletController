/* Pellet Controller panel, 800 x 480, dark (redesign B, palette of
 * RoomSense): background #15181B, cards #22262B border #2E343A, text
 * #F3F4F5, muted #A3ABB3, buttons #343A41, orange #F28C28 heat, blue
 * #7DB7FF setpoint/chrono, teal #4FB3A9 ok, red #F2555A alarm */

QMainWindow, QStackedWidget, QWidget#mainPage, QWidget#chronoPage, QWidget#diagPage
                                    { background: #15181B; }
QLabel                              { color: #F3F4F5; font-size: 16px; background: transparent; }

/* main page: header */
QPushButton#clockButton             { background: transparent; padding: 0; min-height: 48px; }
QPushButton#clockButton:pressed     { background: #22262B; }
QLabel#clockLabel                   { font-size: 34px; font-weight: bold; }
QLabel#dateLabel                    { color: #A3ABB3; font-size: 15px; padding-bottom: 5px; }
QPushButton#statusButton            { background: transparent; padding: 0; min-height: 44px; font-size: 15px; }
QPushButton#statusButton:pressed    { background: #22262B; }
QLabel#stateName                    { color: #A3ABB3; font-size: 15px; }
QLabel#stateText                    { font-size: 15px; font-weight: bold; }
QLabel#stateDot                     { border-radius: 6px; background: #F2555A; }
QLabel#stateDot[on="true"]          { background: #4FB3A9; }

/* main page: cards */
QFrame#card                         { background: #22262B; border: 1px solid #2E343A; border-radius: 14px; }
QFrame#card[alarm="true"]           { border-color: #6E2A2C; }
QLabel#caption                      { color: #A3ABB3; font-size: 14px; }
QLabel#bigValue                     { font-size: 26px; font-weight: bold; }
QLabel#bigValue[hot="true"]         { color: #F28C28; }
QLabel#powerValue                   { font-size: 30px; font-weight: bold; }
QLabel#dateValue                    { font-size: 26px; font-weight: bold; }

QPushButton#chronoButton            { background: #343A41; color: #C9CED3; border: 1px solid #3A4047; font-size: 17px; }
QPushButton#chronoButton[on="true"] { background: #1E2A38; color: #7DB7FF; border-color: #7DB7FF; }
QPushButton#chronoButton:pressed    { background: #4A525B; }

/* main page: key bar */
QFrame#keyBar                       { background: #101215; border: none; border-top: 1px solid #2E343A; }

QFrame#stateChip                    { background: #343A41; border: 1px solid #4A525B; border-radius: 14px; min-height: 22px; }
QFrame#stateChip QLabel#chipText    { color: #C9CED3; font-size: 18px; font-weight: bold; }
QFrame#stateChip[look="active"]     { background: #3A2412; border-color: #F28C28; }
QFrame#stateChip[look="active"] QLabel#chipText  { color: #F28C28; }
QFrame#stateChip[look="alarm"]      { background: #3A1A1C; border-color: #F2555A; }
QFrame#stateChip[look="alarm"] QLabel#chipText   { color: #F2555A; }
QFrame#stateChip[look="warning"]    { background: #3A2A12; border-color: #F28C28; }
QFrame#stateChip[look="warning"] QLabel#chipText { color: #F6C27A; }

/* buttons */
QPushButton                         { background: #343A41; color: #F3F4F5; border: none; border-radius: 12px;
                                      font-size: 18px; font-weight: bold; padding: 0 14px; min-height: 44px; }
QPushButton:pressed                 { background: #4A525B; }
QPushButton:disabled                { background: #262A2F; color: #555C63; }
QPushButton#stepButton              { font-size: 34px; font-weight: normal; padding: 0; }

/* confirmations and messages */
QMessageBox                         { background: #22262B; border: 1px solid #2E343A; }
QMessageBox QLabel                  { font-size: 20px; padding: 12px; min-width: 360px; }
QMessageBox QPushButton             { min-width: 150px; min-height: 60px; }

/* chrono page */
QPushButton#backButton              { min-height: 48px; padding: 0 18px 0 12px; font-size: 20px; }
QLabel#pageTitle                    { font-size: 26px; font-weight: bold; }
QLabel#switchLabel                  { font-size: 18px; font-weight: bold; }
QPushButton#tabButton               { background: #22262B; color: #A3ABB3; border-radius: 0; border-bottom: 3px solid #2E343A;
                                      min-height: 52px; font-size: 18px; }
QPushButton#tabButton:checked       { background: #2A2F35; color: #F3F4F5; border-bottom: 3px solid #4FB3A9; }
QLabel#programTitle                 { font-size: 20px; font-weight: bold; }
QFrame#slotRow                      { background: #2A2F35; border: none; border-radius: 12px; }
QLabel#slotName                     { font-size: 18px; font-weight: bold; }
QPushButton#timeButton              { padding: 0; min-height: 64px; max-height: 64px; }
QPushButton#timeButton:disabled     { background: #343A41; }
QLabel#timeCaption                  { color: #A3ABB3; font-size: 12px; }
QLabel#timeValue                    { font-size: 28px; font-weight: bold; }
QLabel#timeValue[off="true"]        { color: #7D858D; }
QPushButton#slotSelect              { font-size: 20px; padding: 0; min-height: 52px; max-height: 52px; }
QPushButton#slotSelect:checked      { background: #1B2A3A; color: #7DB7FF; border: 1px solid #7DB7FF; }
QPushButton#dayChip                 { background: #2A2F35; color: #7D858D; border-radius: 12px; font-size: 16px; padding: 0; }
QPushButton#dayChip:checked         { background: #1F3B38; color: #4FB3A9; border: 1px solid #4FB3A9; }

/* diagnostic page */
QLabel#diagValue                    { font-size: 18px; font-weight: bold; }
QLabel#diagSection                  { color: #7DB7FF; font-size: 15px; font-weight: bold; padding-top: 8px; }
QLabel#diagValue[look="ok"]         { color: #4FB3A9; }
QLabel#diagValue[look="warning"]    { color: #F6C27A; }
QLabel#diagValue[look="error"]      { color: #F2555A; }

/* time picker */
QDialog#timePicker                  { background: #22262B; border: 1px solid #4A525B; border-radius: 14px; }
QLabel#pickerTitle                  { font-size: 20px; font-weight: bold; }
QPushButton#pickerPart              { background: transparent; color: #A3ABB3; font-size: 64px; font-weight: bold;
                                      padding: 0; border-radius: 12px; min-height: 88px; }
QPushButton#pickerPart:checked      { background: #1B2A3A; color: #7DB7FF; }
QLabel#pickerColon                  { color: #A3ABB3; font-size: 56px; font-weight: bold; }
QPushButton#pickerSave              { background: #4FB3A9; color: #0B1118; }
QPushButton#pickerSave:pressed      { background: #3E968D; }
QPushButton#pickerOff               { color: #F6C27A; }
